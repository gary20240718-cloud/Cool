-- ==========================================
-- 第一部分：UI 介面與狀態控制
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 建立全域狀態，供下方渲染邏輯讀取
_G.ESP_Enabled = false 

-- 建立 UI (開關按鈕)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ESP_UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleESP"
ToggleButton.Size = UDim2.new(0, 150, 0, 50)
ToggleButton.Position = UDim2.new(0, 20, 0.5, -25)
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- 預設紅色(關閉)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Text = "透視: 關閉"
ToggleButton.TextScaled = true
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

-- 按鈕點擊事件
ToggleButton.MouseButton1Click:Connect(function()
    _G.ESP_Enabled = not _G.ESP_Enabled -- 切換狀態
    
    if _G.ESP_Enabled then
        ToggleButton.Text = "透視: 開啟"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 50) -- 綠色
    else
        ToggleButton.Text = "透視: 關閉"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- 紅色
    end
end)
-- ==========================================
-- 第二部分：透視渲染與血量更新邏輯
-- ==========================================
local RunService = game:GetService("RunService")
local ESP_Objects = {} -- 儲存當前已建立透視的玩家與物件

-- 建立單一玩家的透視
local function createESP(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    if ESP_Objects[targetPlayer] then return end
    if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Head") then return end

    local character = targetPlayer.Character

    -- 穿牆高亮 (Highlight)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Color3.fromRGB(255, 50, 50)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- 穿牆關鍵
    highlight.Adornee = character
    highlight.Parent = character

    -- 頭頂名條與血量 (BillboardGui)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true -- 穿牆關鍵
    billboard.Adornee = character.Head
    billboard.Parent = character.Head

    -- 名字文字
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = targetPlayer.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = billboard

    -- 血量條背景
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 0.3, 0)
    healthBg.Position = UDim2.new(0, 0, 0.6, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.Parent = billboard

    -- 血量條本體
    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Parent = healthBg

    -- 儲存物件
    ESP_Objects[targetPlayer] = {
        highlight = highlight,
        billboard = billboard,
        healthBar = healthBar
    }
end

-- 清理單一玩家的透視
local function removeESP(targetPlayer)
    local objects = ESP_Objects[targetPlayer]
    if objects then
        if objects.highlight then objects.highlight:Destroy() end
        if objects.billboard then objects.billboard:Destroy() end
        ESP_Objects[targetPlayer] = nil
    end
end

-- 清理所有透視
local function clearAllESP()
    for player, _ in pairs(ESP_Objects) do
        removeESP(player)
    end
end

-- 核心迴圈：監聽狀態並更新畫面
RunService.RenderStepped:Connect(function()
    -- 若透視關閉，且目前有物件，則全部清除
    if not _G.ESP_Enabled then
        if next(ESP_Objects) ~= nil then
            clearAllESP()
        end
        return
    end

    -- 若透視開啟，檢查所有玩家
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            -- 如果玩家有角色，且還沒建立透視，就建立
            if player.Character and player.Character:FindFirstChild("Head") then
                if not ESP_Objects[player] then
                    createESP(player)
                end
                
                -- 即時更新血量條
                local objects = ESP_Objects[player]
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if objects and humanoid and objects.healthBar then
                    local healthRatio = humanoid.Health / humanoid.MaxHealth
                    objects.healthBar.Size = UDim2.new(healthRatio, 0, 1, 0)
                    
                    -- 血量低於 30% 時變色
                    if healthRatio < 0.3 then
                        objects.healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    else
                        objects.healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    end
                end
            end
        end
    end
end)
