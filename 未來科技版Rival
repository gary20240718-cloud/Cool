-- ==========================================
-- Delta 透視腳本 - 第一部分 (UI與核心)
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local isESPEnabled = false
local ESP_Objects = {}

-- 建立 UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Delta_ESP_Menu"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0, 150, 0, 50)
ToggleButton.Position = UDim2.new(0, 20, 0.5, -25) -- 畫面左側中間
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Text = "透視: 關閉"
ToggleButton.TextScaled = true
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

-- 按鈕點擊事件
ToggleButton.MouseButton1Click:Connect(function()
    isESPEnabled = not isESPEnabled
    if isESPEnabled then
        ToggleButton.Text = "透視: 開啟"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
    else
        ToggleButton.Text = "透視: 關閉"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)
-- ==========================================
-- Delta 透視腳本 - 第二部分 (渲染與更新)
-- ==========================================

-- 建立透視的函數
local function createESP(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    if ESP_Objects[targetPlayer] then return end
    
    -- 安全判定：確保角色和頭部存在
    local character = targetPlayer.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    -- 1. 建立穿牆高亮 (Highlight)
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Color3.fromRGB(255, 50, 50) -- 紅色
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- 穿牆關鍵
    highlight.Adornee = character
    highlight.Parent = character

    -- 2. 建立頭頂名條與血量
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true -- 穿牆關鍵
    billboard.Adornee = head
    billboard.Parent = head

    -- 名字
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = targetPlayer.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = billboard

    -- 血條背景
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 0.3, 0)
    healthBg.Position = UDim2.new(0, 0, 0.6, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.Parent = billboard

    -- 血條本體
    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Parent = healthBg

    -- 記錄下來
    ESP_Objects[targetPlayer] = {
        highlight = highlight,
        billboard = billboard,
        healthBar = healthBar
    }
end

-- 清理透視
local function clearAllESP()
    for player, objects in pairs(ESP_Objects) do
        if objects.highlight then objects.highlight:Destroy() end
        if objects.billboard then objects.billboard:Destroy() end
        ESP_Objects[player] = nil
    end
end

-- 核心更新迴圈
RunService.RenderStepped:Connect(function()
    if not isESPEnabled then
        if next(ESP_Objects) ~= nil then clearAllESP() end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                if not ESP_Objects[player] then
                    createESP(player)
                end
                
                -- 更新血量
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local objects = ESP_Objects[player]
                if humanoid and objects and objects.healthBar then
                    local ratio = humanoid.Health / math.max(humanoid.MaxHealth, 1)
                    objects.healthBar.Size = UDim2.new(ratio, 0, 1, 0)
                    if ratio < 0.3 then
                        objects.healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    else
                        objects.healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    end
                end
            end
        end
    end
end)
