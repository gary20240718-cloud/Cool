-- 狀態
local espEnabled = true
local flyEnabled = false
local tpEnabled = false
local isGoingUp = false
local isGoingDown = false
ESPBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    ESPBtn.Text = "透視: " .. (espEnabled and "開啟" or "關閉")
    ESPBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
    if not espEnabled then
        for _, obj in pairs(ScreenGui:GetChildren()) do
            if obj.Name:match("ESP_") then obj:Destroy() end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input)
    if not flyEnabled then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        local p = input.Position
        if p.X >= UpBtn.AbsolutePosition.X and p.X <= UpBtn.AbsolutePosition.X + UpBtn.AbsoluteSize.X and p.Y >= UpBtn.AbsolutePosition.Y and p.Y <= UpBtn.AbsolutePosition.Y + UpBtn.AbsoluteSize.Y then isGoingUp = true end
        if p.X >= DownBtn.AbsolutePosition.X and p.X <= DownBtn.AbsolutePosition.X + DownBtn.AbsoluteSize.X and p.Y >= DownBtn.AbsolutePosition.Y and p.Y <= DownBtn.AbsolutePosition.Y + DownBtn.AbsoluteSize.Y then isGoingDown = true end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then isGoingUp = false; isGoingDown = false end
end)

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 🚀 飛天邏輯 (穿牆、強制位移)
    if flyEnabled and hrp and humanoid then
        humanoid.PlatformStand = true
        -- 強制關閉自身碰撞，實現穿牆
        for _, p in pairs(char:GetDescendants()) do 
            if p:IsA("BasePart") then p.CanCollide = false end 
        end
        
        local currentY = hrp.Position.Y
        if isGoingUp then currentY = currentY + 1.5 end
        if isGoingDown then currentY = currentY - 1.5 end
        
        local moveDir = humanoid.MoveDirection * 1.5
        local newPos = Vector3.new(hrp.Position.X + moveDir.X, currentY, hrp.Position.Z + moveDir.Z)
        
        -- 強制修改座標
        hrp.CFrame = CFrame.new(newPos)
        hrp.Velocity = Vector3.new(0, 0, 0) 
    else
        if humanoid then humanoid.PlatformStand = false end
    end

    -- 🚀 黏人瞬移邏輯 (找最近的敵人並貼著)
    if tpEnabled and hrp then
        local closestRoot = nil
        local shortestDist = math.huge
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not player:IsTeammate(LocalPlayer) then
                local pRoot = player.Character:FindFirstChild("HumanoidRootPart")
                local pHum = player.Character:FindFirstChildOfClass("Humanoid")
                if pRoot and pHum and pHum.Health > 0 then
                    local d = (hrp.Position - pRoot.Position).Magnitude
                    if d < shortestDist then
                        shortestDist = d
                        closestRoot = pRoot
                    end
                end
            end
        end
        
        if closestRoot then
            -- 強制關閉自身碰撞，實現穿牆追蹤
            for _, p in pairs(char:GetDescendants()) do 
                if p:IsA("BasePart") then p.CanCollide = false end 
            end
            
            -- 計算目標位置：敵人的身體位置，並往後退 3 格，保持空隙方便開槍
            local targetPos = closestRoot.Position
            local direction = (hrp.Position - targetPos).Unit
            local finalPos = targetPos + (direction * 3) -- 距離敵人 3 格
            
            -- 使用 Lerp 平滑追蹤，避免瞬間閃現導致畫面卡頓
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(finalPos), 0.2)
        end
    end

    -- 🚀 白色透視邏輯
    if not espEnabled then return end
    local active = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHead = pChar:FindFirstChild("Head")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")
            
            if pHead and pHum and pHum.Health > 0 then
                active[player.UserId] = true
                local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                local dist = math.floor((Camera.CFrame.Position - pHead.Position).Magnitude)
                
                if onScreen then
                    local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                    if not box then
                        box = Instance.new("Frame")
                        box.Name = "ESP_Box_" .. player.UserId
                        box.BackgroundTransparency = 1
                        box.BorderSizePixel = 1
                        box.BorderColor3 = Color3.fromRGB(255, 255, 255)
                        box.ZIndex = 9999
                        box.Parent = ScreenGui
                    end
                    box.Visible = true
                    box.Size = UDim2.new(0, 40, 0, 50)
                    box.Position = UDim2.new(0, headPos.X - 20, 0, headPos.Y - 10)

                    local text = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId)
                    if not text then
                        text = Instance.new("TextLabel")
                        text.Name = "ESP_Text_" .. player.UserId
                        text.BackgroundTransparency = 1
                        text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        text.TextStrokeTransparency = 0
                        text.Font = Enum.Font.SourceSansBold
                        text.TextSize = 14
                        text.TextXAlignment = Enum.TextXAlignment.Center
                        text.ZIndex = 10000
                        text.Parent = ScreenGui
                    end
                    text.Visible = true
                    text.Size = UDim2.new(0, 150, 0, 50)
                    text.Position = UDim2.new(0, headPos.X - 75, 0, headPos.Y - 60)
                    text.Text = player.Name .. "\n距離: " .. dist .. "m\n血量: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth)
                else
                    local b = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId); if b then b.Visible = false end
                    local t = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId); if t then t.Visible = false end
                end
            end
        end
    end

    for _, obj in pairs(ScreenGui:GetChildren()) do
        if obj.Name:match("ESP_") then
            local idStr = obj.Name:match("%d+")
            if idStr and not active[tonumber(idStr)] then obj:Destroy() end
        end
    end
end)
