local UpBtn = Instance.new("TextButton")
UpBtn.Size = UDim2.new(1, 0, 0.35, 0)
UpBtn.Position = UDim2.new(0, 0, 0.3, 0)
UpBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
UpBtn.Text = "▲上升"
UpBtn.Font = Enum.Font.SourceSansBold
UpBtn.TextSize = 13
UpBtn.Parent = FlyPanel

local DownBtn = Instance.new("TextButton")
DownBtn.Size = UDim2.new(1, 0, 0.35, 0)
DownBtn.Position = UDim2.new(0, 0, 0.65, 0)
DownBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
DownBtn.Text = "▼下降"
