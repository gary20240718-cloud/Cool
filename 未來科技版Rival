-- ==========================================
-- 2. 核心變數
-- ==========================================
local espEnabled = false
local flyEnabled = false
local tpEnabled = false
local tpMode = "Body"
local isGoingUp = false
local isGoingDown = false
-- 觸控判定
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not flyEnabled then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local p = input.Position
        if p.X >= UpBtn.AbsolutePosition.X and p.X <= UpBtn.AbsolutePosition.X + UpBtn.AbsoluteSize.X and
           p.Y >= UpBtn.AbsolutePosition.Y and p.Y <= UpBtn.AbsolutePosition.Y + UpBtn.AbsoluteSize.Y then isGoingUp = true end
        if p.X >= DownBtn.AbsolutePosition.X and p.X <= DownBtn.AbsolutePosition.X + DownBtn.AbsoluteSize.X and
           p.Y >= DownBtn.AbsolutePosition.Y and p.Y <= DownBtn.AbsolutePosition.Y + DownBtn.AbsoluteSize.Y then isGoingDown = true end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        isGoingUp = false
        isGoingDown = false
    end
end)

-- ==========================================
-- 3. 即時運算迴圈
-- ==========================================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 飛天控制
    if flyEnabled and hrp and humanoid then
        local bv = hrp:FindFirstChild("HackFly")
        if bv then
            local moveDir = humanoid.MoveDirection * 60
            if isGoingUp then moveDir = moveDir + Vector3.new(0, 50, 0) end
            if isGoingDown then moveDir = moveDir - Vector3.new(0, 80, 0) end
            if humanoid.MoveDirection.Magnitude == 0 and not isGoingUp and not isGoingDown then
                bv.Velocity = Vector3.new(0, 2, 0)
            else
                bv.Velocity = moveDir
            end
        end
    end

    -- 🚨 瞬移穿牆邏輯
    if tpEnabled and hrp then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        local closestRoot = nil
        local shortestDist = math.huge
        local myPos = hrp.Position

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not player:IsTeammate(LocalPlayer) then
                local pRoot = player.Character:FindFirstChild("HumanoidRootPart")
                local pHum = player.Character:FindFirstChildOfClass("Humanoid")
                if pRoot and pHum and pHum.Health > 0 then
                    local dist = (myPos - pRoot.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestRoot = pRoot
                    end
                end
            end
        end

        if closestRoot then
            local targetPos
            if tpMode == "Body" then
                targetPos = closestRoot.Position
            elseif tpMode == "Head2" then
                targetPos = closestRoot.Position + Vector3.new(0, 2, 0)
            elseif tpMode == "Head5" then
                targetPos = closestRoot.Position + Vector3.new(0, 5, 0)
            end
            
            if targetPos and targetPos.Y > -20 then
                hrp.CFrame = CFrame.new(targetPos)
            end
        end
    end

    -- 透視邏輯
    if not espEnabled then return end

    local activePlayers = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            local pHead = pChar:FindFirstChild("Head")
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHumanoid and pHumanoid.Health > 0 and pHead and pRoot then
                activePlayers[player.UserId] = true
                local dist = math.floor((Camera.CFrame.Position - pRoot.Position).Magnitude)
                local health = math.floor(pHumanoid.Health)
                local maxHealth = math.floor(pHumanoid.MaxHealth)
                
                if not pChar:FindFirstChild("HackHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "HackHighlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 100, 100)
                    hl.FillTransparency = 0.6
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = pChar
                end

                local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position + Vector3.new(0, 0.5, 0))
                
                if onScreen then
                    local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                    if not box then
                        box = Instance.new("Frame")
                        box.Name = "ESP_Box_" .. player.UserId
                        box.BackgroundTransparency = 1
                        box.BorderSizePixel = 1
                        box.BorderColor3 = Color3.fromRGB(0, 255, 255) 
                        box.ZIndex = 9999
                        box.Parent = ScreenGui
                    end
                    box.Visible = true
                    box.Size = UDim2.new(0, 45, 0, 65)
                    box.Position = UDim2.new(0, headPos.X - 22.5, 0, headPos.Y - 10)

                    local text = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId)
                    if not text then
                        text = Instance.new("TextLabel")
                        text.Name = "ESP_Text_" .. player.UserId
                        text.BackgroundTransparency = 1
                        text.TextColor3 = Color3.fromRGB(0, 255, 255)
                        text.TextStrokeTransparency = 0
                        text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        text.Font = Enum.Font.Code
                        text.TextSize = 12
                        text.Size = UDim2.new(0, 200, 0, 50)
                        text.ZIndex = 10000
                        text.Parent = ScreenGui
                    end
                    text.Visible = true
                    text.Text = "[TARGET]\n" .. player.Name .. "\n距離: " .. dist .. "m\nHP: " .. health
                    text.Position = UDim2.new(0, headPos.X - 100, 0, headPos.Y - 60)

                    local bar = ScreenGui:FindFirstChild("ESP_Bar_" .. player.UserId)
                    if not bar then
                        bar = Instance.new("Frame")
                        bar.Name = "ESP_Bar_" .. player.UserId
                        bar.BorderSizePixel = 1
                        bar.BorderColor3 = Color3.fromRGB(0, 255, 255)
                        bar.BackgroundColor3 = Color3.fromRGB(10, 20, 30)
                        bar.ZIndex = 9999
                        bar.Parent = ScreenGui
                        local fill = Instance.new("Frame")
                        fill.Name = "Fill"
                        fill.Size = UDim2.new(1, 0, 1, 0)
                        fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                        fill.ZIndex = 10000
                        fill.Parent = bar
                    end
                    bar.Visible = true
                    bar.Size = UDim2.new(0, 45, 0, 5)
                    bar.Position = UDim2.new(0, headPos.X - 22.5, 0, headPos.Y - 15)
                    bar.Fill.Size = UDim2.new(health / maxHealth, 0, 1, 0)
                    
                    if health / maxHealth > 0.5 then bar.Fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0) 
                    elseif health / maxHealth > 0.2 then bar.Fill.BackgroundColor3 = Color3.fromRGB(255, 255, 0) 
                    else bar.Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0) end

                else
                    local b = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId); if b then b.Visible = false end
                    local t = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId); if t then t.Visible = false end
                    local br = ScreenGui:FindFirstChild("ESP_Bar_" .. player.UserId); if br then br.Visible = false end
                end
            end
        end
    end

    for _, obj in pairs(ScreenGui:GetChildren()) do
        if obj.Name:match("ESP_") then
            local idStr = obj.Name:match("%d+")
            if idStr then
                local id = tonumber(idStr)
                if not activePlayers[id] then obj:Destroy() end
            end
        end
    end
end)
