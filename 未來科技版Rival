local function createNativeESP(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    local character = targetPlayer.Character
    if not character or not character:FindFirstChild("Head") then return end
    local head = character.Head

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Native_ESP_UI"
    billboard.Size = UDim2.new(0, 120, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head
    billboard.Parent = head

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.Size = UDim2.new(1, 0, 0.3, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Parent = billboard

    local healthText = Instance.new("TextLabel")
    healthText.Name = "HealthText"
    healthText.Size = UDim2.new(1, 0, 0.3, 0)
    healthText.Position = UDim2.new(0, 0, 0.3, 0)
    healthText.BackgroundTransparency = 1
    healthText.TextColor3 = Color3.fromRGB(0, 255, 0)
    healthText.TextStrokeTransparency = 0
    healthText.TextScaled = true
    healthText.Font = Enum.Font.SourceSansBold
    healthText.Parent = billboard

    local healthBg = Instance.new("Frame")
    healthBg.Name = "HealthBg"
    healthBg.Size = UDim2.new(1, 0, 0.15, 0)
    healthBg.Position = UDim2.new(0, 0, 0.7, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBg.Parent = billboard
    local UICorner4 = Instance.new("UICorner") UICorner4.CornerRadius = UDim.new(0, 4) UICorner4.Parent = healthBg

    local healthBar = Instance.new("Frame")
    healthBar.Name = "HealthBar"
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.Parent = healthBg
    local UICorner5 = Instance.new("UICorner") UICorner5.CornerRadius = UDim.new(0, 4) UICorner5.Parent = healthBar

    ESP_Objects[targetPlayer] = {
        billboard = billboard, nameLabel = nameLabel,
        healthText = healthText, healthBar = healthBar, healthBg = healthBg
    }
end

local function removeNativeESP(targetPlayer)
    if ESP_Objects[targetPlayer] then
        if ESP_Objects[targetPlayer].billboard then ESP_Objects[targetPlayer].billboard:Destroy() end
        ESP_Objects[targetPlayer] = nil
    end
end

local lastUpdate = 0

RunService.RenderStepped:Connect(function()
    -- 1. 飛天與穿牆物理更新
    if isFlying and bodyVelocity and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        
        -- 處理飛天穿牆 (Noclip)
        if Config.FlyNoclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if root then
            local moveDir = Vector3.new(0, 0, 0)
            local playerModule = LocalPlayer:FindFirstChild("PlayerScripts"):FindFirstChild("PlayerModule")
            if playerModule then
                local controls = require(playerModule):GetControls()
                local moveVector = controls:GetMoveVector()
                
                if moveVector.Magnitude > 0 then
                    -- 完美修正手機搖桿方向
                    moveDir = (Camera.CFrame.LookVector * -moveVector.Z) + (Camera.CFrame.RightVector * moveVector.X)
                end
            end
            if flyUp then moveDir += Vector3.new(0, 1, 0) end
            if flyDown then moveDir -= Vector3.new(0, 1, 0) end
            
            if moveDir.Magnitude > 0 then
                bodyVelocity.Velocity = moveDir.Unit * flySpeed
            else
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end

    -- 2. 透視渲染
    if not Config.Enabled then
        for plr, _ in pairs(ESP_Objects) do removeNativeESP(plr) end
        return
    end

    local tick = tick()
    if tick - lastUpdate < 0.05 then return end
    lastUpdate = tick

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and root and humanoid and humanoid.Health > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude
                
                if dist > MaxDistance then
                    removeNativeESP(player)
                    continue
                end

                if not ESP_Objects[player] then createNativeESP(player) end
                
                local ui = ESP_Objects[player]
                if ui then
                    ui.nameLabel.Visible = Config.Name or Config.Distance
                    if Config.Name and Config.Distance then
                        ui.nameLabel.Text = player.Name .. " [" .. math.floor(dist) .. "m]"
                    elseif Config.Name then
                        ui.nameLabel.Text = player.Name
                    elseif Config.Distance then
                        ui.nameLabel.Text = "[" .. math.floor(dist) .. "m]"
                    end
                    
                    ui.healthText.Visible = Config.HealthText
                    ui.healthText.Text = math.floor(humanoid.Health) .. " HP"
                    
                    ui.healthBg.Visible = Config.HealthBar
                    if Config.HealthBar then
                        local ratio = humanoid.Health / humanoid.MaxHealth
                        ui.healthBar.Size = UDim2.new(ratio, 0, 1, 0)
                        ui.healthBar.BackgroundColor3 = (ratio < 0.3) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                    end
                end

                if Config.Chams then
                    if not Chams_Objects[player] then
                        local h = Instance.new("Highlight")
                        h.FillColor = Color3.fromRGB(255, 50, 50)
                        h.FillTransparency = 0.5
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Adornee = player.Character
                        h.Parent = player.Character
                        Chams_Objects[player] = {Highlight = h}
                    end
                end
            end
        end
    end
end)
