-- 主按鈕點擊與拖拽
local dragging, dragStart, startPos
MainBtn.MouseButton1Click:Connect(function() MenuFrame.Visible = not MenuFrame.Visible end)
MainBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        MenuFrame.Position = UDim2.new(MainBtn.Position.X.Scale, MainBtn.Position.X.Offset + 70, MainBtn.Position.Y.Scale, MainBtn.Position.Y.Offset)
    end
end)
-- ==========================================
-- 第二部分：渲染核心 (距離限制 + 獨立功能 + 染色)
-- ==========================================

local function clearESP()
    for plr, data in pairs(ESP_Drawings) do
        if data.Box then data.Box:Remove() end
        if data.Name then data.Name:Remove() end
        if data.HealthBar then data.HealthBar:Remove() end
        if data.HealthText then data.HealthText:Remove() end
        if data.Distance then data.Distance:Remove() end
    end
    ESP_Drawings = {}
end

RunService.RenderStepped:Connect(function()
    -- 1. 飛天物理移動邏輯
    if isFlying and bodyVelocity and LocalPlayer.Character then
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local moveDir = Vector3.new(0, 0, 0)
            -- 手機搖桿移動 (Roblox 的移動向量)
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local moveVector = humanoid.MoveDirection
                if moveVector.Magnitude > 0 then
                    -- 沿著攝影機方向飛
                    moveDir = (Camera.CFrame.LookVector * moveVector.Z) + (Camera.CFrame.RightVector * moveVector.X)
                end
            end
            
            -- 加上上升/下降
            if flyUp then moveDir += Vector3.new(0, 1, 0) end
            if flyDown then moveDir -= Vector3.new(0, 1, 0) end
            
            if moveDir.Magnitude > 0 then
                bodyVelocity.Velocity = moveDir.Unit * flySpeed
            else
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end

    -- 2. 總開關
    if not Config.Enabled then
        if next(ESP_Drawings) ~= nil then clearESP() end
        if next(Chams_Objects) ~= nil then
            for _, objs in pairs(Chams_Objects) do if objs.Highlight then objs.Highlight:Destroy() end end
            Chams_Objects = {}
        end
        return
    end

    -- 3. 透視渲染
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and root and humanoid and humanoid.Health > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude
                
                -- 350公尺限制
                if dist > MaxDistance then
                    if ESP_Drawings[player] then
                        ESP_Drawings[player].Box.Visible = false
                        ESP_Drawings[player].Name.Visible = false
                        ESP_Drawings[player].HealthBar.Visible = false
                        ESP_Drawings[player].HealthText.Visible = false
                        ESP_Drawings[player].Distance.Visible = false
                    end
                    continue
                end

                -- 全身染色
                if Config.Chams then
                    if not Chams_Objects[player] then
                        local h = Instance.new("Highlight")
                        h.FillColor = Color3.fromRGB(255, 50, 50)
                        h.FillTransparency = 0.5
                        h.OutlineColor = Color3.fromRGB(255, 255, 255)
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Adornee = player.Character
                        h.Parent = player.Character
                        Chams_Objects[player] = {Highlight = h}
                    end
                end

                local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local rootPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))

                if onScreen then
                    local height = math.abs(headPos.Y - rootPos.Y)
                    local width = height / 2
                    
                    if not ESP_Drawings[player] then
                        ESP_Drawings[player] = {
                            Box = Drawing.new("Square"),
                            Name = Drawing.new("Text"),
                            HealthBar = Drawing.new("Line"),
                            HealthText = Drawing.new("Text"),
                            Distance = Drawing.new("Text")
                        }
                        ESP_Drawings[player].Box.Thickness = 1.5
                        ESP_Drawings[player].Box.Color = Color3.fromRGB(255, 50, 50)
                        
                        ESP_Drawings[player].Name.Size = 15
                        ESP_Drawings[player].Name.Center = true
                        ESP_Drawings[player].Name.Outline = true
                        ESP_Drawings[player].Name.Color = Color3.fromRGB(255, 255, 255)
                        
                        ESP_Drawings[player].Distance.Size = 13
                        ESP_Drawings[player].Distance.Center = true
                        ESP_Drawings[player].Distance.Outline = true
                        ESP_Drawings[player].Distance.Color = Color3.fromRGB(0, 255, 200)
                        
                        ESP_Drawings[player].HealthText.Size = 13
                        ESP_Drawings[player].HealthText.Center = true
                        ESP_Drawings[player].HealthText.Outline = true
                        ESP_Drawings[player].HealthText.Color = Color3.fromRGB(0, 255, 0)
                    end
                    
                    local draw = ESP_Drawings[player]
                    
                    draw.Box.Visible = Config.Box
                    if Config.Box then
                        draw.Box.Size = Vector2.new(width, height)
                        draw.Box.Position = Vector2.new(headPos.X - width/2, headPos.Y)
                    end
                    
                    draw.Name.Visible = Config.Name
                    if Config.Name then
                        draw.Name.Text = player.Name
                        draw.Name.Position = Vector2.new(headPos.X, headPos.Y - 35)
                    end

                    draw.Distance.Visible = Config.Distance
                    if Config.Distance then
                        draw.Distance.Text = "[" .. math.floor(dist) .. "m]"
                        draw.Distance.Position = Vector2.new(headPos.X, headPos.Y - 20)
                    end
                    
                    draw.HealthText.Visible = Config.HealthText
                    if Config.HealthText then
                        draw.HealthText.Text = math.floor(humanoid.Health) .. " HP"
                        draw.HealthText.Position = Vector2.new(headPos.X, headPos.Y - 6)
                    end
                    
                    draw.HealthBar.Visible = Config.HealthBar
                    if Config.HealthBar then
                        local healthRatio = humanoid.Health / humanoid.MaxHealth
                        local barHeight = height * healthRatio
                        draw.HealthBar.Thickness = 2.5
                        draw.HealthBar.Color = (healthRatio < 0.3) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                        draw.HealthBar.From = Vector2.new(headPos.X - width/2 - 5, headPos.Y + (height - barHeight))
                        draw.HealthBar.To = Vector2.new(headPos.X - width/2 - 5, headPos.Y + height)
                    end
                else
                    if ESP_Drawings[player] then
                        draw.Box.Visible = false
                        draw.Name.Visible = false
                        draw.HealthBar.Visible = false
                        draw.HealthText.Visible = false
                        draw.Distance.Visible = false
                    end
                end
            end
        end
    end
end)
