-- 狀態
local espEnabled = true
local flyEnabled = false
local tpEnabled = false
local tpMode = "Body"
local isGoingUp = false
local isGoingDown = false
ESPBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    ESPBtn.Text = "透視: " .. (espEnabled and "開啟" or "關閉")
    ESPBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
    if not espEnabled then
        for _, obj in pairs(ScreenGui:GetChildren()) do
            if obj.Name:match("ESP_") then obj:Destroy() end
        end
    end
end)

local function setTPMode(btn, mode)
    tpMode = mode
    for _, b in pairs({btnBody, btnHead2, btnHead5}) do
        b.BackgroundColor3 = Color3.fromRGB(10, 20, 30)
        b.TextColor3 = Color3.fromRGB(0, 255, 255)
    end
    btn.BackgroundColor3 = Color3.fromRGB(0, 80, 120)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
end
btnBody.MouseButton1Click:Connect(function() setTPMode(btnBody, "Body") end)
btnHead2.MouseButton1Click:Connect(function() setTPMode(btnHead2, "Head2") end)
btnHead5.MouseButton1Click:Connect(function() setTPMode(btnHead5, "Head5") end)

UserInputService.InputBegan:Connect(function(input)
    if not flyEnabled then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        local p = input.Position
        if p.X >= UpBtn.AbsolutePosition.X and p.X <= UpBtn.AbsolutePosition.X + UpBtn.AbsoluteSize.X and p.Y >= UpBtn.AbsolutePosition.Y and p.Y <= UpBtn.AbsolutePosition.Y + UpBtn.AbsoluteSize.Y then isGoingUp = true end
        if p.X >= DownBtn.AbsolutePosition.X and p.X <= DownBtn.AbsolutePosition.X + DownBtn.AbsoluteSize.X and p.Y >= DownBtn.AbsolutePosition.Y and p.Y <= DownBtn.AbsolutePosition.Y + DownBtn.AbsoluteSize.Y then isGoingDown = true end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then isGoingUp = false; isGoingDown = false end
end)

