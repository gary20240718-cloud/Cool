local function checkTeleportLimit()
    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not p:IsTeammate(LocalPlayer) then
            if p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
                count = count + 1
            end
        end
    end
    
    if count > 5 then
        promptUI.Visible = true
        task.wait(3)
        promptUI.Visible = false
        tpEnabled = false
    end
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 🚨 絕對飛天 (無視重力，強制鎖定高度)
    if flyEnabled and hrp and humanoid then
        humanoid.PlatformStand = true
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        
        local currentY = hrp.Position.Y
        if isGoingUp then currentY = currentY + 1.5 end
        if isGoingDown then currentY = currentY - 1.5 end
        
        local moveDir = humanoid.MoveDirection * 1.5
        local newPos = Vector3.new(hrp.Position.X + moveDir.X, currentY, hrp.Position.Z + moveDir.Z)
        
        hrp.CFrame = CFrame.new(newPos)
        hrp.Velocity = Vector3.new(0, 0, 0) 
    else
        if humanoid then humanoid.PlatformStand = false end
    end

    -- 瞬移 (人數限制)
    if tpEnabled and hrp then
        local enemies = {}
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not player:IsTeammate(LocalPlayer) then
                local pRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if pRoot and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    table.insert(enemies, pRoot)
                end
            end
        end
        
        if #enemies > 0 and #enemies <= 5 then
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
            local closest, dist = nil, math.huge
            for _, root in pairs(enemies) do
                local d = (hrp.Position - root.Position).Magnitude
                if d < dist then dist = d; closest = root end
            end
            if closest then
                local pos = closest.Position
                if tpMode == "Head2" then pos = pos + Vector3.new(0, 2, 0) end
                if tpMode == "Head5" then pos = pos + Vector3.new(0, 5, 0) end
                if pos.Y > -20 then hrp.CFrame = CFrame.new(pos) end
            end
        end
    end

    -- 透視 (白色文字與方框)
    if not espEnabled then return end
    local active = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHead = pChar:FindFirstChild("Head")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")
            
            if pHead and pHum and pHum.Health > 0 then
                active[player.UserId] = true
                local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                local dist = math.floor((Camera.CFrame.Position - pHead.Position).Magnitude)
                
                if onScreen then
                    local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                    if not box then
                        box = Instance.new("Frame")
                        box.Name = "ESP_Box_" .. player.UserId
                        box.BackgroundTransparency = 1
                        box.BorderSizePixel = 1
                        box.BorderColor3 = Color3.fromRGB(255, 255, 255) -- 白色方框
                        box.ZIndex = 9999
                        box.Parent = ScreenGui
                    end
                    box.Visible = true
                    box.Size = UDim2.new(0, 40, 0, 50)
                    box.Position = UDim2.new(0, headPos.X - 20, 0, headPos.Y - 10)

                    local text = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId)
                    if not text then
                        text = Instance.new("TextLabel")
                        text.Name = "ESP_Text_" .. player.UserId
                        text.BackgroundTransparency = 1
                        text.TextColor3 = Color3.fromRGB(255, 255, 255) -- 純白文字
                        text.TextStrokeTransparency = 0
                        text.Font = Enum.Font.SourceSansBold
                        text.TextSize = 14
                        text.TextXAlignment = Enum.TextXAlignment.Center
                        text.ZIndex = 10000
                        text.Parent = ScreenGui
                    end
                    text.Visible = true
                    text.Size = UDim2.new(0, 150, 0, 50)
                    text.Position = UDim2.new(0, headPos.X - 75, 0, headPos.Y - 60)
                    text.Text = player.Name .. "\n距離: " .. dist .. "m\n血量: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth)
                else
                    local b = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId); if b then b.Visible = false end
                    local t = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId); if t then t.Visible = false end
                end
            end
        end
    end

    for _, obj in pairs(ScreenGui:GetChildren()) do
        if obj.Name:match("ESP_") then
            local idStr = obj.Name:match("%d+")
            if idStr and not active[tonumber(idStr)] then obj:Destroy() end
        end
    end
end)
