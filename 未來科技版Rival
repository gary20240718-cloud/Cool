local function createModeBtn(text, posX, modeValue)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.28, 0, 0, 30)
    btn.Position = UDim2.new(posX, 0, 0, 195)
    btn.BackgroundColor3 = Color3.fromRGB(10, 20, 30)
