-- 點擊判定
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not flyEnabled then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local p = input.Position
        if p.X >= UpBtn.AbsolutePosition.X and p.X <= UpBtn.AbsolutePosition.X + UpBtn.AbsoluteSize.X and
           p.Y >= UpBtn.AbsolutePosition.Y and p.Y <= UpBtn.AbsolutePosition.Y + UpBtn.AbsoluteSize.Y then isGoingUp = true end
        if p.X >= DownBtn.AbsolutePosition.X and p.X <= DownBtn.AbsolutePosition.X + DownBtn.AbsoluteSize.X and
           p.Y >= DownBtn.AbsolutePosition.Y and p.Y <= DownBtn.AbsolutePosition.Y + DownBtn.AbsoluteSize.Y then isGoingDown = true end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        isGoingUp = false
        isGoingDown = false
    end
end)

-- 每幀運算
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 飛天
    if flyEnabled and hrp then
        UpBtn.Visible = true
        DownBtn.Visible = true
        humanoid.PlatformStand = true
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        
        local moveDir = humanoid.MoveDirection * 2
        if isGoingUp then moveDir = moveDir + Vector3.new(0, 2, 0) end
        if isGoingDown then moveDir = moveDir - Vector3.new(0, 3, 0) end
        if humanoid.MoveDirection.Magnitude == 0 and not isGoingUp and not isGoingDown then
            hrp.Velocity = Vector3.new(0, 0, 0)
        else
            hrp.CFrame = hrp.CFrame + moveDir
        end
    else
        UpBtn.Visible = false
        DownBtn.Visible = false
        if humanoid then humanoid.PlatformStand = false end
    end

    -- 瞬移
    if tpEnabled and hrp then
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        local enemies = {}
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not player:IsTeammate(LocalPlayer) then
                local pRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if pRoot and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    table.insert(enemies, pRoot)
                end
            end
        end
        if #enemies > 0 and #enemies <= 5 then
            local closest, dist = nil, math.huge
            for _, root in pairs(enemies) do
                local d = (hrp.Position - root.Position).Magnitude
                if d < dist then dist = d; closest = root end
            end
            if closest then
                local pos = closest.Position
                if tpMode == "Head2" then pos = pos + Vector3.new(0, 2, 0) end
                if tpMode == "Head5" then pos = pos + Vector3.new(0, 5, 0) end
                if pos.Y > -20 then hrp.CFrame = CFrame.new(pos) end
            end
        end
    end

    -- 透視 (暴力文字與方框)
    if not espEnabled then return end
    local active = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHead = pChar:FindFirstChild("Head")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHead and pHum and pHum.Health > 0 and pRoot then
                active[player.UserId] = true
                local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                local dist = math.floor((Camera.CFrame.Position - pRoot.Position).Magnitude)
                
                if onScreen then
                    local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                    if not box then
                        box = Instance.new("Frame")
                        box.Name = "ESP_Box_" .. player.UserId
                        box.BackgroundTransparency = 1
                        box.BorderSizePixel = 2
                        box.BorderColor3 = Color3.fromRGB(0, 255, 255)
                        box.ZIndex = 99999
                        box.Parent = ScreenGui
                    end
                    box.Visible = true
                    box.Size = UDim2.new(0, 45, 0, 65)
                    box.Position = UDim2.new(0, headPos.X - 22.5, 0, headPos.Y - 10)

                    local text = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId)
                    if not text then
                        text = Instance.new("TextLabel")
                        text.Name = "ESP_Text_" .. player.UserId
                        text.BackgroundTransparency = 1
                        text.TextColor3 = Color3.fromRGB(0, 255, 255)
                        text.TextStrokeTransparency = 0
                        text.Font = Enum.Font.Code
                        text.TextSize = 14
                        text.ZIndex = 100000
                        text.Parent = ScreenGui
                    end
                    text.Visible = true
                    text.Text = player.Name .. "\n距離: " .. dist .. "m"
                    text.Position = UDim2.new(0, headPos.X - 75, 0, headPos.Y - 45)
                else
                    local b = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId); if b then b.Visible = false end
                    local t = ScreenGui:FindFirstChild("ESP_Text_" .. player.UserId); if t then t.Visible = false end
                end
            end
        end
    end

    for _, obj in pairs(ScreenGui:GetChildren()) do
        if obj.Name:match("ESP_") then
            local idStr = obj.Name:match("%d+")
            if idStr and not active[tonumber(idStr)] then obj:Destroy() end
        end
    end
end)
