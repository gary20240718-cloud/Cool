-- ==========================================
-- 1. UI 介面
-- ==========================================
local MainBtn = Instance.new("TextButton")
MainBtn.Size = UDim2.new(0, 50, 0, 50)
MainBtn.Position = UDim2.new(0, 10, 0.3, 0)
MainBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
MainBtn.Text = "ESP"
MainBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
MainBtn.Font = Enum.Font.SourceSansBold
MainBtn.TextSize = 16
MainBtn.Parent = ScreenGui
local UICorner = Instance.new("UICorner") UICorner.CornerRadius = UDim.new(1, 0) UICorner.Parent = MainBtn

local MenuFrame = Instance.new("Frame")
MenuFrame.Size = UDim2.new(0, 160, 0, 280)
MenuFrame.Position = UDim2.new(0, 70, 0.3, 0)
MenuFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MenuFrame.Visible = false
MenuFrame.Parent = ScreenGui
local UICorner2 = Instance.new("UICorner") UICorner2.Parent = MenuFrame

local function createToggle(text, posY, configKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text .. (Config[configKey] and " [ON]" or " [OFF]")
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.Parent = MenuFrame
    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        btn.Text = text .. (Config[configKey] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        if configKey == "Chams" and not Config[configKey] then
            for _, objs in pairs(Chams_Objects) do if objs.Highlight then objs.Highlight:Destroy() end end
            Chams_Objects = {}
        end
    end)
end

createToggle("總開關", 10, "Enabled")
createToggle("方框", 45, "Box")
createToggle("名字", 80, "Name")
createToggle("距離", 115, "Distance")
createToggle("血量數字", 150, "HealthText")
createToggle("左側血條", 185, "HealthBar")
createToggle("全身染色", 220, "Chams")
MainBtn.MouseButton1Click:Connect(function() MenuFrame.Visible = not MenuFrame.Visible end)

-- 飛天面板 (縮小並移到右側不擋路的地方)
