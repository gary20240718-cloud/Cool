-- 🎛️ 建立科技感圓形開關
local function createSwitch(posY, text)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.9, 0, 0, 35)
    frame.Position = UDim2.new(0.05, 0, 0, posY)
    frame.BackgroundTransparency = 1
    frame.Parent = Main

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 220, 255)
    label.TextSize = 13
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    -- 開關背景
    local switchBg = Instance.new("TextButton")
    switchBg.Size = UDim2.new(0, 50, 0, 24)
    switchBg.Position = UDim2.new(1, -50, 0, 5)
    switchBg.BackgroundColor3 = Color3.fromRGB(10, 20, 30)
    switchBg.BorderColor3 = Color3.fromRGB(0, 255, 255)
    switchBg.BorderSizePixel = 1
    switchBg.Text = ""
    switchBg.Parent = frame
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    -- 圓形按鈕
    local switchDot = Instance.new("Frame")
    switchDot.Size = UDim2.new(0, 20, 0, 20)
    switchDot.Position = UDim2.new(0, 2, 0, 2)
    switchDot.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
    switchDot.BorderColor3 = Color3.fromRGB(0, 255, 255)
    switchDot.BorderSizePixel = 1
    switchDot.Parent = switchBg
    Instance.new("UICorner", switchDot).CornerRadius = UDim.new(1, 0)

    -- 點擊事件
    switchBg.MouseButton1Click:Connect(function()
        local isOn = switchBg.BackgroundColor3 == Color3.fromRGB(0, 50, 80)
        if isOn then
            switchBg.BackgroundColor3 = Color3.fromRGB(10, 20, 30)
            switchDot.Position = UDim2.new(0, 2, 0, 2)
            switchDot.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
        else
            switchBg.BackgroundColor3 = Color3.fromRGB(0, 50, 80)
            switchDot.Position = UDim2.new(1, -22, 0, 2)
            switchDot.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
        end
        
        -- 控制邏輯
        if text == "透視 (ESP)" then
            espEnabled = not espEnabled
            if not espEnabled then
                for _, obj in pairs(ScreenGui:GetChildren()) do
                    if obj.Name:match("ESP_") then obj:Destroy() end
                end
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HackHighlight") then p.Character.HackHighlight:Destroy() end
                end
            end
        elseif text == "飛天 (穿牆)" then
            flyEnabled = not flyEnabled
            UpBtn.Visible = flyEnabled
            DownBtn.Visible = flyEnabled
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                if flyEnabled then
                    char.Humanoid.PlatformStand = true
                    char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
                    local bv = Instance.new("BodyVelocity")
                    bv.Name, bv.MaxForce, bv.Velocity = "HackFly", Vector3.new(1e5, 1e5, 1e5), Vector3.new(0, 0, 0)
                    bv.Parent = char.HumanoidRootPart
                else
                    char.Humanoid.PlatformStand = false
                    if char.HumanoidRootPart:FindFirstChild("HackFly") then char.HumanoidRootPart.HackFly:Destroy() end
                    for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end end
                end
            end
        elseif text == "瞬移 (穿牆)" then
            tpEnabled = not tpEnabled
        end
    end)
    return switchBg
end

